{
  "manifest_version": 3,
  "name": "Sift",
  "description": "Extract names and usernames from the rendered DOM of the active page and review them locally.",
  "version": "0.1.0",
  "action": {
    "default_title": "Sift",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": ["activeTab", "scripting", "storage"],
  "host_permissions": ["http://127.0.0.1:5174/*", "http://localhost:5174/*"],
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content-script.js"],
      "run_at": "document_idle"
    }
  ]
}
