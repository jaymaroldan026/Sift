{
  "name": "sift",
  "version": "0.1.10",
  "description": "Local-first Chromium extension and dashboard for extracting names and usernames from rendered webpages.",
  "type": "module",
  "private": false,
  "scripts": {
    "dev": "concurrently \"npm:dev:server\" \"npm:dev:dashboard\"",
    "dev:dashboard": "vite --config dashboard/vite.config.ts --host 127.0.0.1",
    "dev:server": "tsx watch server/src/index.ts",
    "start:server": "tsx server/src/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "build": "npm run build:server && npm run build:extension",
    "build:dashboard": "vite build --config dashboard/vite.config.ts",
    "build:server": "tsc -p tsconfig.server.json",
    "build:extension": "npm run build:dashboard && vite build --config extension/vite.config.ts && node scripts/build-extension.mjs && node scripts/validate-extension.mjs dist/extension",
    "validate:extension": "node scripts/validate-extension.mjs dist/extension",
    "package:release": "npm run build && node scripts/package-release.mjs"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^5.0.0",
    "better-sqlite3": "^12.2.0",
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "nanoid": "^5.1.5",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "zod": "^4.0.14"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/chrome": "^0.2.5",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/jsdom": "^28.0.3",
    "@types/node": "^24.1.0",
    "@types/react": "^19.1.9",
    "@types/react-dom": "^19.1.7",
    "@vitest/ui": "^3.2.4",
    "concurrently": "^9.2.0",
    "jsdom": "^30.0.1",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3",
    "vite": "^7.0.6",
    "vitest": "^3.2.4"
  }
}
